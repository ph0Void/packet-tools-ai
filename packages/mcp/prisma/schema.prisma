generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "sqlite"
}

enum TypeDeviceMcp {
  PACKET_TRACER
  GNS3
  CISCO
  HUAWEI
  ARUBA
  MIKROTIK
  JUNOS // JUNIPER
  FORTIGATE
  H3C
  PALO_ALTO
  ARISTA
  VYOS
  GENERIC
}

enum ConnectionProtocolMcp {
  SIMULATION
  SSH
  TELNET
  SERIAL
}

model DeviceProviderMcp {
  id         String        @id @default(cuid())
  name       String
  typeDevice TypeDeviceMcp @default(GENERIC)

  protocol ConnectionProtocolMcp @default(SIMULATION)

  host String?
  port Int?

  serialPort     String?
  serialBaudrate Int?    @default(9600)

  username String?
  password String?

  status String @default("OFFLINE")

  isTemporary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorCache VendorCacheMcp?

  @@index([typeDevice])
  @@index([protocol])
}

model VendorCacheMcp {
  id String @id @default(cuid())

  providerId String            @unique
  provider   DeviceProviderMcp @relation(fields: [providerId], references: [id], onDelete: Cascade)

  vendorId String

  prompt String?
  source String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillMcp {
  id String @id @default(cuid())

  slug        String  @unique
  title       String
  description String?
  content     String

  source String @default("agent")

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model PlanRecordMcp {
  id String @id @default(cuid())

  objective String
  filePath  String

  status String @default("PENDING")

  totalSteps     Int @default(0)
  completedSteps Int @default(0)
  failedSteps    Int @default(0)

  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
