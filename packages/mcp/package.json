{
  "name": "@packet-tools-ai/mcp",
  "version": "1.3.2",
  "description": "Servidor MCP de Packet Tools (stdio + HTTP /mcp y /sse)",
  "main": "dist/app.js",
  "bin": {
    "packet-tools-mcp": "dist/app.js"
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations",
    "skills"
  ],
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "node scripts/prisma-generate.mjs && tsc && node scripts/rewrite-dist.mjs",
    "start": "node dist/app.js",
    "migrate": "prisma migrate dev --name packet-tools-mcp",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "reset": "prisma migrate reset --force",
    "test": "tsx test/smoke.ts",
    "test:bridge": "tsx test/bridge.test.ts",
    "test:protocol": "node scripts/verify-protocol.cjs",
    "test:http": "node scripts/verify-http.cjs",
    "inspect-db": "node scripts/inspect-db.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "packet-tracer",
    "gns3",
    "serial",
    "sse",
    "streamable-http"
  ],
  "author": "ph0Void",
  "homepage": "https://github.com/ph0Void/packet-tools-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph0Void/packet-tools-ai.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ph0Void/packet-tools-ai/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  }
}
