# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/out/
**/.next/

# production
/build
/dist
packages/server/dist/
packages/desktop/dist/

# turbo
.turbo/
**/.turbo/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
*.log
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.example.env

# bases de datos locales (SQLite del backend y del MCP)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# datos de ejecución del backend
packages/server/uploads/
packages/server/prisma/migrations/

# electron / instalador de escritorio
packages/desktop/dist/
packages/desktop/.staging/
packages/desktop/.cache/

# runtime empaquetado de la app web
packages/app/runtime/
packages/app/build-info.json

/examples/*

# agents
.agents/*
/.agents/*
.opencode/*
.claudio/*
.opencode.json

#

# PRIVATE
PRIVATE.md
BACKLOG.md
RESUME.md

# OPENCODE
opencode.json

# WEB SITE
website/*
